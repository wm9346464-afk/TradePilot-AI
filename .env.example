# ============================================================
# TradePilot AI 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================================================

# ----------------------------------------------------------
# PayPal API 配置（沙箱环境）
# 在 https://developer.paypal.com/ 创建应用获取
# ----------------------------------------------------------

# PayPal 客户端ID（留空则使用 Demo 模式）
PAYPAL_CLIENT_ID=

# PayPal 客户端密钥（留空则使用 Demo 模式）
PAYPAL_CLIENT_SECRET=

# PayPal 商家邮箱（必须是沙箱账号中已验证的邮箱；留空则使用 Demo 模式）
# 登录 https://www.sandbox.paypal.com/ 查看沙箱商家账号
PAYPAL_MERCHANT_EMAIL=

# PayPal 商家名称（可选，默认 TradePilot AI）
PAYPAL_MERCHANT_NAME=TradePilot AI

# PayPal Sandbox Personal account email used as the demo buyer.
# Leave empty in public/demo mode. Do not use a real customer email.
PAYPAL_SANDBOX_BUYER_EMAIL=

# ----------------------------------------------------------
# 大模型 API 配置（用于AI合同深度审查）
# 支持 OpenAI 兼容接口（如豆包、DeepSeek、通义千问等）
# ----------------------------------------------------------

# API 密钥（留空则使用基础规则检查模式）
LLM_API_KEY=

# API 接口地址（OpenAI 兼容格式）
# 豆包: https://ark.cn-beijing.volces.com/api/v3/chat/completions
# DeepSeek: https://api.deepseek.com/chat/completions
# OpenAI: https://api.openai.com/v1/chat/completions
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 模型名称
# 豆包: doubao-1-5-pro-32k-250115
# DeepSeek: deepseek-chat
# OpenAI: gpt-4o
LLM_MODEL_NAME=doubao-1-5-pro-32k-250115

# ----------------------------------------------------------
# 生产信号服务配置（可选，高级用户）
# 不配置时默认使用 Demo Signal Provider（合成数据）
# 配置后使用 RemoteSignalProvider 调用私有生产信号服务
# ----------------------------------------------------------

# 私有信号服务API地址（可选）
# 注意：API只应返回信号状态，不应返回策略参数或原始数据
SIGNAL_API_URL=

# 私有信号服务API密钥（可选）
SIGNAL_API_KEY=

# ----------------------------------------------------------
# 可选：公开部署访问密码
# 设置后，Streamlit页面会先要求输入该密码；留空则不启用。
# ----------------------------------------------------------

APP_PASSWORD=

# ----------------------------------------------------------
# TrustLoop development controls
# ----------------------------------------------------------

# Payment backend for app_trustloop.py:
# fake = deterministic demo, rest = real PayPal Sandbox
TRUSTLOOP_PAYPAL_BACKEND=fake

# Use the configured LLM planner. Set to false for deterministic tests/offline demos.
TRUSTLOOP_USE_LLM=true

# FX source for cross-currency settlement plans:
# fixture = offline deterministic rates, live = Frankfurter reference rates
FX_PROVIDER=fixture

# Hard USD-equivalent ceiling for any single milestone.
MAX_INVOICE_AMOUNT_USD=10000

# Demo Trust Ladder amounts in the selected invoice currency.
TRUSTLOOP_SAMPLE_AMOUNT=500
TRUSTLOOP_TRIAL_AMOUNT=5000
TRUSTLOOP_DEPOSIT_AMOUNT=9000

# Optional SQLite path for resumable runs and public Passport verification.
# Leave empty for an in-memory demo. Example: data/trustloop.db
TRUSTLOOP_STORE_PATH=

# Optional issuer-signing secret for Trust Passports. Use at least 32 random
# characters and keep this value only in .env or deployment Secrets.
TRUSTLOOP_PASSPORT_SIGNING_KEY=

# PayPal webhook endpoint used by webhook_server.py.
# Register https://your-domain.example/paypal/webhook in the PayPal dashboard.
PAYPAL_WEBHOOK_ID=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8787
