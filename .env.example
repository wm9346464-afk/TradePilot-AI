# ============================================================
# TradePilot AI 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================================================

# ----------------------------------------------------------
# PayPal API 配置（沙箱环境）
# 在 https://developer.paypal.com/ 创建应用获取
# ----------------------------------------------------------

# PayPal 客户端ID（留空则使用 Demo 模式）
PAYPAL_CLIENT_ID=

# PayPal 客户端密钥（留空则使用 Demo 模式）
PAYPAL_CLIENT_SECRET=

# PayPal 商家邮箱（必须是沙箱账号中已验证的邮箱；留空则使用 Demo 模式）
# 登录 https://www.sandbox.paypal.com/ 查看沙箱商家账号
PAYPAL_MERCHANT_EMAIL=

# PayPal 商家名称（可选，默认 TradePilot AI）
PAYPAL_MERCHANT_NAME=TradePilot AI

# ----------------------------------------------------------
# 大模型 API 配置（用于AI合同深度审查）
# 支持 OpenAI 兼容接口（如豆包、DeepSeek、通义千问等）
# ----------------------------------------------------------

# API 密钥（留空则使用基础规则检查模式）
LLM_API_KEY=

# API 接口地址（OpenAI 兼容格式）
# 豆包: https://ark.cn-beijing.volces.com/api/v3/chat/completions
# DeepSeek: https://api.deepseek.com/chat/completions
# OpenAI: https://api.openai.com/v1/chat/completions
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 模型名称
# 豆包: doubao-1-5-pro-32k-250115
# DeepSeek: deepseek-chat
# OpenAI: gpt-4o
LLM_MODEL_NAME=doubao-1-5-pro-32k-250115

# ----------------------------------------------------------
# 生产信号服务配置（可选，高级用户）
# 不配置时默认使用 Demo Signal Provider（合成数据）
# 配置后使用 RemoteSignalProvider 调用私有生产信号服务
# ----------------------------------------------------------

# 私有信号服务API地址（可选）
# 注意：API只应返回信号状态，不应返回策略参数或原始数据
SIGNAL_API_URL=

# 私有信号服务API密钥（可选）
SIGNAL_API_KEY=

# ----------------------------------------------------------
# 可选：公开部署访问密码
# 设置后，Streamlit页面会先要求输入该密码；留空则不启用。
# ----------------------------------------------------------

APP_PASSWORD=
